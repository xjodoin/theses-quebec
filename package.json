{
  "name": "theses-quebec-static",
  "version": "0.1.0",
  "description": "Static-site build pipeline: SQLite → Rangefind index → dist/",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build_rangefind.mjs --slim",
    "serve": "node scripts/serve.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:fetch": "node scripts/fetch_db.mjs",
    "db:release": "node scripts/release_db.mjs",
    "build:update": "node scripts/build_rangefind.mjs --update --slim",
    "build:full": "node scripts/build_rangefind.mjs"
  },
  "devDependencies": {
    "better-sqlite3": "^11.0.0",
    "playwright-core": "^1.59.1",
    "rangefind": "^0.2.0"
  }
}
